---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import heroScribbles from '../assets/hero-scribbles.svg';

const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-gray-900 text-gray-400">
  <Image
    src={heroScribbles}
    alt=""
    aria-hidden="true"
    class="absolute top-0 inset-x-0 w-full h-auto opacity-25 pointer-events-none select-none"
  />
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <a href="/" aria-label="Pauci home">
        <Logo textClass="text-white" markClass="h-7" />
      </a>

      <nav class="flex flex-wrap justify-center gap-6 text-sm">
        <a href="#benefits" class="hover:text-white transition-colors">Prečo Pauči</a>
        <a href="#solutions" class="hover:text-white transition-colors">Naše riešenia</a>
        <a href="#how-it-works" class="hover:text-white transition-colors">Ako to funguje</a>
        <a href="#contact" class="hover:text-white transition-colors">Kontakt</a>
      </nav>
    </div>

    <div class="mt-10 border-t border-gray-800 pt-6 text-center text-xs">
      &copy; {currentYear} Pauci. All rights reserved.
    </div>
  </div>
</footer>
