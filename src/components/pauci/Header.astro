---
import Logo from './Logo.astro';
import { getLang, pauciHref, pouchyHref } from '../../i18n';

const lang = getLang(Astro.currentLocale);

const content = {
  sk: {
    navLinks: [
      { label: 'Prečo Pauči', href: pauciHref(lang, '#benefits') },
      { label: 'Ako funguje', href: pauciHref(lang, '#how-it-works') },
      { label: 'O produkte', href: pauciHref(lang, '#product') },
      { label: 'FAQ', href: pauciHref(lang, '#faq') },
      { label: 'Kontakt', href: pauciHref(lang, '#contact') },
    ],
    cta: 'Pilot pre školu',
    menuLabel: 'Otvoriť menu',
  },
  en: {
    navLinks: [
      { label: 'Why Pauči', href: pauciHref(lang, '#benefits') },
      { label: 'How it works', href: pauciHref(lang, '#how-it-works') },
      { label: 'Product', href: pauciHref(lang, '#product') },
      { label: 'FAQ', href: pauciHref(lang, '#faq') },
      { label: 'Contact', href: pauciHref(lang, '#contact') },
    ],
    cta: 'School pilot',
    menuLabel: 'Toggle menu',
  },
} as const;

const t = content[lang];

const langLinks = [
  { code: 'sk', label: 'SK', href: pauciHref('sk') },
  { code: 'en', label: 'EN', href: pauciHref('en') },
] as const;

/** Sub-brand attribution shown next to the logo, e.g. "od Pouchy". */
const byPouchy = {
  sk: 'od',
  en: 'by',
} as const;
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <div class="flex items-center gap-2.5">
      <a href={pauciHref(lang)} aria-label="Pauci home">
        <Logo />
      </a>
      <!-- Sub-brand attribution: states the brand hierarchy rather than
           implying browser history the way a back arrow does. -->
      <span class="hidden sm:block text-xs text-ink/60 whitespace-nowrap pt-0.5">
        {byPouchy[lang]}{' '}
        <a
          href={pouchyHref(lang)}
          class="font-semibold text-ink/70 hover:text-ink underline decoration-ink/20 underline-offset-2 hover:decoration-ink transition-colors"
        >
          Pouchy
        </a>
      </span>
    </div>

    <nav class="hidden md:flex items-center gap-8">
      {t.navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-semibold text-ink/70 hover:text-ink transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-5">
      <div class="flex items-center gap-1.5 text-sm font-semibold" aria-label="Language">
        {langLinks.map(({ code, label, href }, i) => (
          <>
            {i > 0 && <span class="text-ink/30" aria-hidden="true">/</span>}
            <a
              href={href}
              aria-current={code === lang ? 'page' : undefined}
              class={code === lang ? 'text-ink' : 'text-ink/50 hover:text-ink transition-colors'}
            >
              {label}
            </a>
          </>
        ))}
      </div>

      <a
        href={pauciHref(lang, "#contact")}
        class="inline-flex items-center px-4 py-2 rounded-full bg-coral text-white text-sm font-medium hover:bg-coral-700 transition-colors"
      >
        {t.cta}
      </a>
    </div>

    <!-- Mobile nav toggle (CSS-only, no JS required) -->
    <label
      for="mobile-menu-toggle"
      class="md:hidden p-2 rounded-md text-ink/70 hover:text-ink cursor-pointer"
      aria-label={t.menuLabel}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <input type="checkbox" id="mobile-menu-toggle" class="sr-only peer/menu" aria-hidden="true" />

  <!-- Mobile menu panel -->
  <div id="mobile-menu-panel" class="hidden peer-checked/menu:block md:hidden border-t border-gray-100 bg-cream">
    <nav class="flex flex-col px-4 py-4 gap-4">
      {t.navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-semibold text-ink/70 hover:text-ink transition-colors"
        >
          {label}
        </a>
      ))}

      <div class="flex items-center gap-1.5 text-sm font-semibold" aria-label="Language">
        {langLinks.map(({ code, label, href }, i) => (
          <>
            {i > 0 && <span class="text-ink/30" aria-hidden="true">/</span>}
            <a
              href={href}
              aria-current={code === lang ? 'page' : undefined}
              class={code === lang ? 'text-ink' : 'text-ink/50 hover:text-ink transition-colors'}
            >
              {label}
            </a>
          </>
        ))}
      </div>

      <a
        href={pauciHref(lang, "#contact")}
        class="inline-flex items-center justify-center px-4 py-2 rounded-full bg-coral text-white text-sm font-medium hover:bg-coral-700 transition-colors"
      >
        {t.cta}
      </a>

      <a
        href={pouchyHref(lang)}
        class="border-t border-ink/10 pt-4 text-sm text-ink/70 hover:text-ink transition-colors"
      >
        {byPouchy[lang]} <span class="font-semibold">Pouchy</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement | null;
  const panel = document.getElementById('mobile-menu-panel');

  if (toggle) {
    // Width-only check so mobile browsers' collapsing URL bar (height change) doesn't close the menu
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth !== lastWidth) {
        lastWidth = window.innerWidth;
        toggle.checked = false;
      }
    });

    panel?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.checked = false;
      });
    });
  }
</script>
