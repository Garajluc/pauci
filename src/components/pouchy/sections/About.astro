---
import { getLang } from '../../../i18n';
import { pouchyContent } from '../content';

const lang = getLang(Astro.currentLocale);
const t = pouchyContent[lang].about;
---

<section id="about" class="border-b border-ink/10 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <p class="text-sm font-bold uppercase tracking-widest text-coral mb-5">
      {t.title}
    </p>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink leading-tight max-w-3xl">
      {t.tagline}
    </h2>
    <p class="mt-6 max-w-2xl text-lg text-ink/70 leading-relaxed">
      {t.leadIntro}
    </p>
    <p class="mt-3 max-w-2xl text-lg font-semibold text-ink leading-relaxed">
      {t.leadQuestion}
    </p>

    <h3 class="mt-16 text-xl sm:text-2xl font-bold tracking-tight text-ink leading-tight">
      {t.storyHeading}
    </h3>
    <div class="mt-8 max-w-2xl space-y-5">
      {t.story.map((paragraph) => (
        <p class="text-ink/70 leading-relaxed">{paragraph}</p>
      ))}
    </div>

    <h3 class="mt-16 text-xl sm:text-2xl font-bold tracking-tight text-ink leading-tight">
      {t.valuesHeading}
    </h3>
    <div class="mt-8 grid gap-10 sm:grid-cols-3">
      {t.values.map(({ title, body }) => (
        <div>
          <h4 class="text-lg font-bold text-ink">{title}</h4>
          <p class="mt-2.5 text-ink/70 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
