---
const navLinks = [
  { label: 'Benefits', href: '#benefits' },
  { label: 'Solutions', href: '#solutions' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href="/" class="text-xl font-bold text-brand-600 tracking-tight">Pauci</a>

    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-medium text-gray-600 hover:text-brand-600 transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <a
      href="#contact"
      class="hidden md:inline-flex items-center px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-700 transition-colors"
    >
      Get in touch
    </a>

    <!-- Mobile nav toggle (CSS-only, no JS required) -->
    <label
      for="mobile-menu-toggle"
      class="md:hidden p-2 rounded-md text-gray-600 hover:text-brand-600 cursor-pointer"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
    <input type="checkbox" id="mobile-menu-toggle" class="sr-only peer/menu" aria-hidden="true" />
  </div>

  <!-- Mobile menu panel -->
  <div class="hidden peer-checked/menu:block md:hidden border-t border-gray-100 bg-white">
    <nav class="flex flex-col px-4 py-4 gap-4">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-medium text-gray-600 hover:text-brand-600 transition-colors"
        >
          {label}
        </a>
      ))}
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-700 transition-colors"
      >
        Get in touch
      </a>
    </nav>
  </div>
</header>
