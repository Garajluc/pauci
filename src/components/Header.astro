---
import Logo from './Logo.astro';

const navLinks = [
  { label: 'Prečo Pauči', href: '#benefits' },
  { label: 'Ako funguje', href: '#how-it-works' },
  { label: 'O produkte', href: '#product' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Kontakt', href: '#contact' },
];
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href="/" aria-label="Pauci home">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-semibold text-ink/70 hover:text-ink transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <a
      href="#contact"
      class="hidden md:inline-flex items-center px-4 py-2 rounded-full bg-coral text-white text-sm font-medium hover:bg-coral-700 transition-colors"
    >
      Pilot pre školu
    </a>

    <!-- Mobile nav toggle (CSS-only, no JS required) -->
    <label
      for="mobile-menu-toggle"
      class="md:hidden p-2 rounded-md text-ink/70 hover:text-ink cursor-pointer"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <input type="checkbox" id="mobile-menu-toggle" class="sr-only peer/menu" aria-hidden="true" />

  <!-- Mobile menu panel -->
  <div id="mobile-menu-panel" class="hidden peer-checked/menu:block md:hidden border-t border-gray-100 bg-cream">
    <nav class="flex flex-col px-4 py-4 gap-4">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm font-semibold text-ink/70 hover:text-ink transition-colors"
        >
          {label}
        </a>
      ))}
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-4 py-2 rounded-full bg-coral text-white text-sm font-medium hover:bg-coral-700 transition-colors"
      >
        Pilot pre školu
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement | null;
  const panel = document.getElementById('mobile-menu-panel');

  if (toggle) {
    // Width-only check so mobile browsers' collapsing URL bar (height change) doesn't close the menu
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth !== lastWidth) {
        lastWidth = window.innerWidth;
        toggle.checked = false;
      }
    });

    panel?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.checked = false;
      });
    });
  }
</script>
