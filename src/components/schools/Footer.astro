---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import heroScribbles from '../../assets/hero-scribbles.svg';
import { getLang, siteHref } from '../../i18n';

const currentYear = new Date().getFullYear();

const lang = getLang(Astro.currentLocale);

const content = {
  sk: {
    navLinks: [
      { label: 'Prečo Pouchy', href: siteHref(lang, '#benefits') },
      { label: 'Ako funguje', href: siteHref(lang, '#how-it-works') },
      { label: 'O produkte', href: siteHref(lang, '#product') },
      { label: 'FAQ', href: siteHref(lang, '#faq') },
      { label: 'Kontakt', href: siteHref(lang, '#contact') },
    ],
    rights: 'Všetky práva vyhradené.',
    homeLabel: 'Pouchy pre školy – domov',
  },
  en: {
    navLinks: [
      { label: 'Why Pouchy', href: siteHref(lang, '#benefits') },
      { label: 'How it works', href: siteHref(lang, '#how-it-works') },
      { label: 'Product', href: siteHref(lang, '#product') },
      { label: 'FAQ', href: siteHref(lang, '#faq') },
      { label: 'Contact', href: siteHref(lang, '#contact') },
    ],
    rights: 'All rights reserved.',
    homeLabel: 'Pouchy for schools – home',
  },
} as const;

const t = content[lang];
---

<footer class="relative overflow-hidden bg-gray-900 text-gray-400">
  <Image
    src={heroScribbles}
    alt=""
    aria-hidden="true"
    class="absolute top-0 inset-x-0 w-full h-auto opacity-25 pointer-events-none select-none"
  />
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <a href={siteHref(lang)} aria-label={t.homeLabel}>
        <Logo class="h-7 text-white" />
      </a>

      <nav class="flex flex-wrap justify-center gap-6 text-sm">
        {t.navLinks.map(({ label, href }) => (
          <a href={href} class="hover:text-white transition-colors">{label}</a>
        ))}
      </nav>
    </div>

    <div class="mt-10 border-t border-gray-800 pt-6 text-center text-xs">
      <p>&copy; {currentYear} Pouchy. {t.rights}</p>
    </div>
  </div>
</footer>
