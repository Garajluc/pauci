---
import { getLang } from '../../../i18n';

const lang = getLang(Astro.currentLocale);

const content = {
  sk: {
    kicker: 'Ako vyzerá jeden školský deň',
    heading: 'Pouchy sa prispôsobí bežnému fungovaniu školy.',
    moments: [
      {
        label: 'Ráno',
        description: 'Žiak vloží telefón do svojho Pouchy a uzamkne ho.',
      },
      {
        label: 'Počas vyučovania',
        description:
          'Telefón zostáva pri žiakovi v taške alebo vo vrecku, ale nie je dostupný na používanie.',
      },
      {
        label: 'Po skončení vyučovania',
        description:
          'Žiak príde k centrálnemu odomykaciemu zariadeniu, Pouchy otvorí a telefón môže opäť používať.',
      },
    ],
  },
  en: {
    kicker: 'A typical school day',
    heading: "Pouchy fits into the school's everyday routine.",
    moments: [
      {
        label: 'Morning',
        description: 'The student puts their phone into their own Pouchy and locks it.',
      },
      {
        label: 'During lessons',
        description:
          "The phone stays with the student in their bag or pocket, but isn't available for use.",
      },
      {
        label: 'After school',
        description:
          'The student walks up to the central unlocking device, opens their Pouchy and can use the phone again.',
      },
    ],
  },
} as const;

const t = content[lang];
---

<section id="school-day" class="py-20 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-sm font-bold uppercase tracking-widest text-coral mb-3">
        {t.kicker}
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink max-w-3xl mx-auto leading-tight">
        {t.heading}
      </h2>
    </div>

    <div class="relative">
      <!-- hand-drawn timeline connecting the three moments (desktop only) -->
      <svg
        class="hidden md:block absolute top-5 left-[16%] right-[16%] w-[68%] h-6 text-ink/25"
        viewBox="0 0 600 24"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M6 14 C 100 6, 200 20, 300 12 C 400 5, 500 18, 594 10"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-dasharray="1 10"
        />
      </svg>

      <ol class="grid gap-12 md:grid-cols-3">
        {t.moments.map(({ label, description }, i) => (
          <li class="relative flex flex-col items-center text-center">
            <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full bg-coral text-white font-extrabold">
              {i + 1}
            </span>
            <h3 class="mt-5 text-xl font-bold text-ink">{label}</h3>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink/70">
              {description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
