---
import Highlight from '../../Highlight.astro';
import { getLang } from '../../../i18n';

const lang = getLang(Astro.currentLocale);

const content = {
  sk: {
    yearLabel: 'Regulácia používania mobilov na základných školách',
    heading: 'Mobily v školách potrebujú jasné pravidlá.',
    p1: 'Mobilné telefóny sú prirodzenou súčasťou života detí. Počas vyučovania však môžu odvádzať pozornosť, narúšať sústredenie a obmedzovať prirodzenú interakciu medzi žiakmi.',
    p2a: 'Od januára 2025 sa používanie mobilných telefónov na slovenských základných školách reguluje.',
    p2Highlight: 'Školy si pritom musia nastaviť vlastný spôsob,',
    p2b: 'ako pravidlá zaviesť do každodenného fungovania.',
    p3: 'Pouchy prináša jednoduchý spôsob, ako používanie mobilov obmedziť bez toho, aby škola musela telefóny od žiakov hromadne preberať a skladovať.',
    linkLabel: 'Viac o regulácii mobilov na školách',
  },
  en: {
    yearLabel: 'Regulation of phone use in primary schools',
    heading: 'Phones in schools need clear rules.',
    p1: "Mobile phones are a natural part of children's lives. During lessons, however, they can distract attention, disrupt focus and limit natural interaction between students.",
    p2a: 'Since January 2025, the use of mobile phones in Slovak primary schools has been regulated.',
    p2Highlight: 'Each school must choose its own way',
    p2b: 'to bring the rules into everyday practice.',
    p3: 'Pouchy offers a simple way to limit phone use without the school having to collect and store the phones every day.',
    linkLabel: 'More about the phone regulation in schools',
  },
} as const;

const t = content[lang];
---

<section id="why-now" class="pt-20 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[2fr_3fr] md:gap-0 items-center">
      <!-- Left: big year + short label -->
      <div class="flex flex-col items-center text-center md:items-end md:text-right md:pr-14 lg:pr-20">
        <span class="relative inline-block">
          <span class="text-7xl sm:text-8xl lg:text-9xl font-extrabold tracking-tight text-coral leading-none">
            2025
          </span>
          <!-- hand-drawn underline -->
          <svg
            class="absolute left-0 -bottom-3 w-full h-5"
            viewBox="0 0 200 20"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 12 C 40 6, 90 16, 130 10 C 160 6, 185 12, 196 9"
              stroke="#FFB361"
              stroke-width="6"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <p class="mt-8 text-lg font-semibold text-ink max-w-xs">
          {t.yearLabel}
        </p>
      </div>

      <!-- Right: explanation -->
      <div class="md:border-l md:border-ink/15 md:pl-14 lg:pl-20 text-center md:text-left">
        <h2 class="text-3xl sm:text-4xl font-bold text-ink leading-tight mb-6">
          {t.heading}
        </h2>
        <p class="text-lg text-ink/70 leading-relaxed mb-4">
          {t.p1}
        </p>
        <p class="text-lg text-ink/70 leading-relaxed mb-4">
          {t.p2a}
          <Highlight>{t.p2Highlight}</Highlight>{' '}
          {t.p2b}
        </p>
        <p class="text-lg font-semibold text-ink leading-relaxed">
          {t.p3}
        </p>
        <a
          href="https://www.minedu.sk/data/att/4dd/31672.0c6aa4.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 font-semibold text-coral hover:text-coral-700 transition-colors"
        >
          {t.linkLabel}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-5" viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 26 C 18 20, 36 22, 52 24" />
            <path d="M42 14 C 46.6 18, 51 21.4, 56 24.2 C 50.6 27, 45.8 30.4, 41.4 34.4" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
