---
import { Image } from 'astro:assets';
import Highlight from '../../Highlight.astro';
import PouchPlaceholder from '../../PouchPlaceholder.astro';
import heroScribbles from '../../../assets/hero-scribbles.svg';
import paperPlane from '../../../assets/paper-plane.png';
import { getLang } from '../../../i18n';

const lang = getLang(Astro.currentLocale);

const content = {
  sk: {
    headlineHighlight: 'Jednoduchá',
    headlineRest: ' regulácia mobilov počas vyučovania.',
    lead: 'Žiak má svoj telefón stále pri sebe, ale',
    leadHighlight: 'počas vyučovania ho nemôže používať.',
    sub: 'Pouchy je uzamykateľné puzdro na mobilný telefón navrhnuté pre každodenné používanie v školách.',
    ctaPilot: 'Mám záujem o pilot',
    ctaHow: 'Ako to funguje',
    pouchAlt: 'Textilné puzdro Pouchy na mobilný telefón',
    pouchPlaceholder: 'Ilustračný obrázok – finálna fotografia produktu bude doplnená',
  },
  en: {
    headlineHighlight: 'Simple',
    headlineRest: ' phone regulation during lessons.',
    lead: 'Students keep their phones with them, but',
    leadHighlight: 'cannot use them during lessons.',
    sub: 'Pouchy is a lockable phone pouch designed for everyday use in schools.',
    ctaPilot: "I'm interested in a pilot",
    ctaHow: 'How it works',
    pouchAlt: 'Pouchy fabric phone pouch',
    pouchPlaceholder: 'Placeholder illustration – the final product photo is coming',
  },
} as const;

const t = content[lang];
---

<section class="relative">
  <Image
    src={heroScribbles}
    alt=""
    aria-hidden="true"
    class="absolute top-0 inset-x-0 w-full h-auto -z-10 opacity-35 pointer-events-none select-none"
    loading="eager"
  />
  <!-- Second copy straddling the hero/next-section boundary, fading out downwards for a smooth transition -->
  <Image
    src={heroScribbles}
    alt=""
    aria-hidden="true"
    class="absolute top-full inset-x-0 w-full h-auto -translate-y-[15%] -z-10 opacity-25 pointer-events-none select-none [mask-image:linear-gradient(to_bottom,black_55%,transparent_100%)]"
    loading="eager"
  />
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-2 items-center">
      <div class="relative text-center md:text-left">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6 text-ink">
          <span class="relative inline-block">
            <svg
              class="absolute left-[-7%] top-[-6%] w-[114%] h-[112%]"
              viewBox="0 0 635 141"
              preserveAspectRatio="none"
              aria-hidden="true"
