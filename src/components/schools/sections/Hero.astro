            <span class="relative">{t.headlineHighlight}</span>
          </span>{t.headlineRest}
        </h1>
        <p class="max-w-xl mx-auto md:mx-0 text-lg sm:text-xl text-ink/80 font-medium mb-4">
          {t.lead}
          <Highlight>{t.leadHighlight}</Highlight>
        </p>
        <p class="max-w-xl mx-auto md:mx-0 text-lg text-ink/70 mb-10">
          {t.sub}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-8 py-3 rounded-full bg-coral text-white font-semibold hover:bg-coral-700 transition-colors"
          >
            {t.ctaPilot}
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center px-8 py-3 rounded-full border-2 border-ink bg-transparent text-ink font-semibold hover:bg-ink/5 transition-colors"
          >
            {t.ctaHow}
          </a>
        </div>

        <Image
          src={paperPlane}
          alt=""
          aria-hidden="true"
          class="hidden md:block absolute z-[60] top-[calc(100%+40px)] left-11 w-[18rem] h-auto pointer-events-none select-none"
          loading="lazy"
        />
      </div>

      <PouchPlaceholder
        alt={t.pouchAlt}
        caption={t.pouchPlaceholder}
        class="hidden md:block mx-auto w-full max-w-[320px]"
        frameClass="bg-white/60"
      />
    </div>
  </div>
</section>
