---
import { getLang } from '../../../i18n';

const lang = getLang(Astro.currentLocale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const content = {
  sk: {
    kicker: 'Prečo Pouchy',
    heading: 'Navrhnuté pre každodenný život v škole.',
    benefits: [
      {
        image: `${base}/yes.png`,
        imageAlt: 'áno',
        title: 'Bezpečný mechanizmus',
        description:
          'Mechanizmus navrhujeme s dôrazom na bezpečné používanie deťmi. Neobsahuje ihlice ani podobné ostré prvky používané v niektorých existujúcich riešeniach.',
      },
      {
        image: `${base}/hi.png`,
        imageAlt: 'hey',
        title: 'Jednoduché používanie',
        description:
          'Na uzamknutie puzdra nie je potrebné žiadne ďalšie zariadenie. Centrálne zariadenie sa používa až pri jeho otvorení.',
      },
      {
        image: `${base}/oooh.png`,
        imageAlt: 'oooh',
        title: 'Telefón zostáva pri žiakovi',
        description:
          'Škola nemusí každé ráno telefóny preberať, skladovať ani ich na konci vyučovania rozdávať späť.',
      },
      {
        image: `${base}/aahhh.png`,
        imageAlt: 'aahhh',
        title: 'Dizajn vytvorený pre školy',
        description:
          'Pouchy navrhujeme ako predmet, ktorý prirodzene patrí do školského prostredia – funkčný, jednoduchý a hravý.',
      },
    ],
  },
  en: {
    kicker: 'Why Pouchy',
    heading: 'Designed for everyday school life.',
    benefits: [
      {
        image: `${base}/yes.png`,
        imageAlt: 'yes',
        title: 'Safe mechanism',
        description:
          "The mechanism is designed with children's safety in mind. It contains no pins or similar sharp parts used in some existing solutions.",
      },
      {
        image: `${base}/hi.png`,
        imageAlt: 'hey',
        title: 'Easy to use',
        description:
          'No extra device is needed to lock the pouch. The central device is only used to open it.',
      },
      {
        image: `${base}/oooh.png`,
        imageAlt: 'oooh',
        title: 'The phone stays with the student',
        description:
          "The school doesn't have to collect phones every morning, store them, or hand them back at the end of the day.",
      },
      {
        image: `${base}/aahhh.png`,
        imageAlt: 'aahhh',
        title: 'Designed for schools',
        description:
          'We design Pouchy as an object that naturally belongs in the school environment — functional, simple and playful.',
      },
    ],
  },
} as const;

const t = content[lang];
---

<section id="benefits" class="pt-20 scroll-mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-sm font-bold uppercase tracking-widest text-coral mb-3">
        {t.kicker}
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink">
        {t.heading}
      </h2>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {t.benefits.map(({ image, imageAlt, title, description }) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <img src={image} alt={imageAlt} class="h-8 w-auto object-contain mb-3" />
          <h3 class="text-lg font-semibold text-ink mb-2">{title}</h3>
          <p class="text-ink/70 text-sm leading-relaxed">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
