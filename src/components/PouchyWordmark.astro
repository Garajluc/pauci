---
/**
 * The Pouchy wordmark as one piece of artwork (letters + smile). Used by every
 * brand surface so height and colour are all a caller needs; `currentColor`
 * lets it inherit the brand blue or switch to white on dark ground.
 */
interface Props {
  /** Tailwind classes for the wordmark (height and colour) */
  class?: string;
  /** Accessible name; pass '' and aria-hidden when a parent supplies the label. */
  label?: string;
}

const { class: className = 'h-7 text-ink', label = 'Pouchy' } = Astro.props;
