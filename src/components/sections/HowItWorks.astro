---
import { Image } from 'astro:assets';
import scribblePeach from '../../assets/scribble-peach.png';

const steps = [
  {
    icon: 'insert',
    title: 'Vlož mobil do Pauči',
    description:
      'Na začiatku vyučovania si žiak vloží svoj telefón do vlastného puzdra Pauči.',
  },
  {
    icon: 'locked',
    title: 'Uzamkni a maj pri sebe',
    description:
      'Puzdro sa jednoducho uzamkne a mobil ostáva žiakovi — v taške či vo vrecku, no bez rozptyľovania.',
  },
  {
    icon: 'unlock',
    title: 'Prilož k boxu a otvor',
    description:
      'Po vyučovaní stačí priložiť puzdro k odomykaciemu boxu a telefón je opäť voľný.',
  },
];
---

<section id="how-it-works" class="relative py-20 bg-[#FFD09E] scroll-mt-28">
  <!-- Wobbly top edge of the background band -->
  <svg
    class="absolute bottom-full left-0 w-full h-8 sm:h-12 text-[#FFD09E]"
    viewBox="0 0 1440 50"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M0 30 C 120 12, 260 45, 420 30 C 580 16, 720 44, 900 32 C 1060 22, 1210 40, 1440 24 L1440 50 L0 50 Z"
    />
  </svg>

  <!-- Wobbly bottom edge of the background band -->
  <svg
    class="absolute top-full left-0 w-full h-8 sm:h-12 text-[#FFD09E]"
    viewBox="0 0 1440 50"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M0 0 L1440 0 L1440 22 C 1290 38, 1130 12, 970 24 C 810 36, 650 10, 490 22 C 330 34, 150 14, 0 28 Z"
    />
  </svg>

  <!-- Peach crayon scribble bridging this section and the one above (decorative) -->
  <Image
    src={scribblePeach}
    alt=""
    aria-hidden="true"
    class="absolute -z-10 left-0 top-0 -translate-x-[12%] -translate-y-[70%] w-[20rem] sm:w-[26rem] lg:w-[32rem] h-auto pointer-events-none select-none"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-4xl sm:text-5xl font-bold text-white">Ako to funguje</h2>
      <p class="mt-4 text-lg text-white/80 max-w-xl mx-auto">
        Tri jednoduché kroky, ktoré zvládne každý žiak.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {steps.map(({ icon, title, description }, i) => (
        <div class="relative flex flex-col overflow-hidden rounded-2xl bg-[#FFF7EE] p-8 pt-28 text-left">
          <span class="absolute top-6 right-8 text-4xl font-extrabold text-ink/20" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {/* Illustration in the top-left of the card */}
          <div class="absolute top-6 left-6 h-20 w-20 text-coral pointer-events-none select-none">
            {icon === 'insert' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-full w-full" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.8 21.5 C 9.4 28.6, 9.2 35.8, 11.4 41.6 C 16.2 44.8, 31.8 45, 36.6 41.2 C 38.8 34.8, 38.4 27.4, 37.2 20.9" />
                <path d="M10.8 21.5 C 16 18.4, 32 18.2, 37.2 20.9" />
                <path d="M12.4 23.2 C 17.2 20.8, 30.8 20.6, 35.6 22.8" stroke-width="2" />
                <path d="M18.6 20.8 C 18.2 15.8, 18 10.6, 18.5 6.4 C 20.9 5.2, 26.5 5.1, 29 6.2 C 29.6 11, 29.7 16, 29.4 21.2" />
                <path d="M22 9.2 C 23.6 8.8, 25.1 8.8, 26.4 9.1" stroke-width="2.2" />
                <path d="M13.6 9 C 12.5 7.7, 11.6 6.6, 10.8 5.3" stroke-width="2.4" />
                <path d="M34.4 9.4 C 35.5 8.1, 36.3 7, 37.1 5.7" stroke-width="2.4" />
                <path d="M23.9 3.6 C 23.9 2.8, 23.9 2.2, 24 1.6" stroke-width="2.4" />
              </svg>
            )}
            {icon === 'locked' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-full w-full" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 13.6 C 10.6 22, 10.4 32.6, 12.6 40.8 C 17.4 43.9, 30.8 44.1, 35.6 40.5 C 37.7 32.4, 37.5 21.8, 36.1 13.4" />
                <path d="M10.9 14.8 C 16.4 10.6, 31.8 10.4, 37.3 14.3 C 38.1 16.8, 38 18.8, 37.2 21.2 C 31.2 24.6, 16.6 24.7, 11 21.6 C 10.2 19, 10.2 17.2, 10.9 14.8 Z" />
                <path d="M21.4 31.8 C 21.3 29, 21.9 27.9, 24 27.9 C 26.1 27.9, 26.7 29.1, 26.6 31.7" stroke-width="2.6" />
                <path d="M19.8 31.9 C 22.6 31.3, 25.5 31.3, 28.2 31.8 C 28.7 34.1, 28.6 35.9, 28.1 37.9 C 25.3 38.7, 22.6 38.7, 20 38 C 19.4 35.9, 19.4 34, 19.8 31.9 Z" stroke-width="2.6" />
                <path d="M6.8 20 C 5.4 19.8, 4.2 19.6, 3 19.3" stroke-width="2.4" />
                <path d="M41.2 20.4 C 42.6 20.2, 43.8 19.9, 45 19.6" stroke-width="2.4" />
                <path d="M8.6 7.4 C 7.6 6.4, 6.7 5.5, 5.8 4.5" stroke-width="2.4" />
                <path d="M39.4 7.8 C 40.4 6.8, 41.3 5.8, 42.2 4.8" stroke-width="2.4" />
                <path d="M23.9 5.6 C 23.9 4.6, 23.9 3.6, 24 2.6" stroke-width="2.4" />
              </svg>
            )}
            {icon === 'unlock' && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-full w-full" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19.8 5.8 C 17.2 10.4, 15.4 16.2, 15.2 21.8 C 17.6 24.9, 26.6 25.2, 29.6 22.4 C 30.4 16.4, 29.4 10.2, 27.6 5.4" />
                <path d="M19.8 5.8 C 22.4 4.3, 25.2 4.2, 27.6 5.4" />
                <path d="M9.8 33.2 C 18.6 31.4, 29.6 31.4, 38.4 33.4 C 39.5 36.4, 39.5 38.9, 38.7 41.7 C 29.4 43.8, 18.4 43.7, 9.3 41.5 C 8.5 38.7, 8.7 35.9, 9.8 33.2 Z" />
                <path d="M17.6 28.4 C 20.4 27, 27.6 26.9, 30.6 28.2" stroke-width="2.4" />
                <path d="M19.8 30.8 C 22 30, 26 30, 28.2 30.7" stroke-width="2.4" />
                <path d="M5.6 30.2 C 4.6 29.2, 3.8 28.4, 3 27.5" stroke-width="2.4" />
                <path d="M42.4 30.6 C 43.4 29.6, 44.2 28.7, 45 27.8" stroke-width="2.4" />
                <path d="M37.4 14.6 C 34.4 12.2, 33.1 9.8, 34.7 8.2 C 35.9 7, 37.4 7.6, 37.9 9 C 38.5 7.6, 40.1 7.2, 41.2 8.5 C 42.6 10.1, 40.6 12.6, 37.4 14.6 Z" stroke-width="2.4" />
              </svg>
            )}
          </div>
          <h3 class="mt-4 text-xl font-bold text-ink">{title}</h3>
          <p class="mt-3 text-ink/70 text-sm leading-relaxed max-w-xs">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
