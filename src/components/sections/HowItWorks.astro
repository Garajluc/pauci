---
import { Image } from 'astro:assets';
import scribblePeach from '../../assets/scribble-peach.png';

const steps = [
  {
    title: 'Vlož mobil',
    description:
      'Na začiatku vyučovania si žiak vloží telefón do vlastného puzdra Pauči.',
  },
  {
    title: 'Uzamkni a maj pri sebe',
    description:
      'Puzdro sa uzamkne samostatne bez potreby ďalšieho zariadenia. Telefón zostáva počas školského dňa pri žiakovi, ale nie je možné ho používať.',
  },
  {
    title: 'Prilož a otvor',
    description:
      'Na otvorenie puzdra žiak použije centrálne umiestnené odomykacie zariadenie.',
  },
];
---

<section id="how-it-works" class="relative py-20 bg-[#FFD09E] scroll-mt-28">
  <!-- Wobbly top edge of the background band -->
  <svg
    class="absolute bottom-full left-0 w-full h-8 sm:h-12 text-[#FFD09E]"
    viewBox="0 0 1440 50"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M0 30 C 120 12, 260 45, 420 30 C 580 16, 720 44, 900 32 C 1060 22, 1210 40, 1440 24 L1440 50 L0 50 Z"
    />
  </svg>

  <!-- Wobbly bottom edge of the background band -->
  <svg
    class="absolute top-full left-0 w-full h-8 sm:h-12 text-[#FFD09E]"
    viewBox="0 0 1440 50"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M0 0 L1440 0 L1440 22 C 1290 38, 1130 12, 970 24 C 810 36, 650 10, 490 22 C 330 34, 150 14, 0 28 Z"
    />
  </svg>

  <!-- Peach crayon scribble bridging this section and the one above (decorative) -->
  <Image
    src={scribblePeach}
    alt=""
    aria-hidden="true"
    class="absolute -z-10 left-0 top-0 -translate-x-[12%] -translate-y-[70%] w-[20rem] sm:w-[26rem] lg:w-[32rem] h-auto pointer-events-none select-none"
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-sm font-bold uppercase tracking-widest text-coral mb-3">
        Ako funguje Pauči
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink">
        Tri jednoduché kroky.
      </h2>
    </div>

    <div class="grid items-center gap-8 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:gap-3 lg:gap-5">
      {steps.map(({ title, description }, i) => (
        <>
          {i > 0 && (
            <div class="flex items-center justify-center text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="hidden md:block h-10 w-12" viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 26 C 18 20, 36 22, 52 24" />
                <path d="M42 14 C 46.6 18, 51 21.4, 56 24.2 C 50.6 27, 45.8 30.4, 41.4 34.4" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="md:hidden h-12 w-9 rotate-90 -my-2" viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 26 C 18 20, 36 22, 52 24" />
                <path d="M42 14 C 46.6 18, 51 21.4, 56 24.2 C 50.6 27, 45.8 30.4, 41.4 34.4" />
              </svg>
            </div>
          )}
          <div
            class={`relative rounded-2xl bg-[#FFF7EE] px-7 pt-12 pb-9 text-center shadow-md md:min-h-[15rem] ${
              i === 1 ? 'md:rotate-1' : 'md:-rotate-1'
            }`}
          >
            <span
              class={`absolute -top-6 left-1/2 -translate-x-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-coral text-white text-lg font-extrabold shadow-md ${
                i === 1 ? '-rotate-6' : 'rotate-6'
              }`}
            >
              {i + 1}
            </span>
            <h3 class="text-xl font-bold text-ink">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{description}</p>
          </div>
        </>
      ))}
    </div>
  </div>
</section>
