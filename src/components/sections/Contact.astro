---
import { Image } from 'astro:assets';
import heroScribbles from '../../assets/hero-scribbles.svg';

// TODO: replace with the real contact address
const contactEmail = 'info@pauci.sk';
---

<section id="contact" class="relative py-20 scroll-mt-16">
  <Image
    src={heroScribbles}
    alt=""
    aria-hidden="true"
    class="absolute bottom-0 inset-x-0 w-full h-auto -z-10 opacity-35 pointer-events-none select-none"
  />
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl sm:text-5xl font-bold text-ink">Kontaktujte nás</h2>
      <p class="mt-4 text-lg text-ink/70">
        Máte otázku alebo chcete začať? Napíšte nám.
      </p>
    </div>

    <form
      id="contact-form"
      class="space-y-6 bg-white rounded-2xl p-8 border border-gray-100 shadow-sm"
      data-contact-email={contactEmail}
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="first-name" class="block text-sm font-medium text-ink mb-1">
            Meno
          </label>
          <input
            id="first-name"
            name="first-name"
            type="text"
            autocomplete="given-name"
            required
            class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-coral focus:border-transparent transition"
            placeholder="Jana"
          />
        </div>
        <div>
          <label for="last-name" class="block text-sm font-medium text-ink mb-1">
            Priezvisko
          </label>
          <input
            id="last-name"
            name="last-name"
            type="text"
            autocomplete="family-name"
            required
            class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-coral focus:border-transparent transition"
            placeholder="Nováková"
          />
        </div>
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-ink mb-1">
          E-mailová adresa
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-coral focus:border-transparent transition"
          placeholder="jana@priklad.sk"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-ink mb-1">
          Správa
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-coral focus:border-transparent transition resize-none"
          placeholder="Napíšte nám, ako vám môžeme pomôcť…"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full inline-flex items-center justify-center px-6 py-3 rounded-full bg-coral text-white font-semibold hover:bg-coral-700 transition-colors focus:outline-none focus:ring-2 focus:ring-coral focus:ring-offset-2"
      >
        Odoslať správu
      </button>

      <p class="text-center text-sm text-ink/60">
        Odoslaním sa otvorí váš e-mailový klient so správou pripravenou na
        adresu <a href={`mailto:${contactEmail}`} class="underline hover:text-coral">{contactEmail}</a>.
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const firstName = String(data.get('first-name') ?? '');
    const lastName = String(data.get('last-name') ?? '');
    const email = String(data.get('email') ?? '');
    const message = String(data.get('message') ?? '');

    const subject = `Správa z webu od ${firstName} ${lastName}`.trim();
    const body = `${message}\n\n—\n${firstName} ${lastName}\n${email}`;

    const to = form.dataset.contactEmail ?? '';
    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
