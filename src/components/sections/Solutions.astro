---
const solutions = [
  {
    tag: 'Product',
    title: 'Streamlined Workflows',
    description:
      'Replace tangled processes with clear, automated pipelines that free your team to focus on what matters.',
    cta: 'Explore workflows',
    href: '#contact',
  },
  {
    tag: 'Platform',
    title: 'Unified Dashboard',
    description:
      'A single source of truth for all your data — no more context-switching between a dozen tools.',
    cta: 'See the platform',
    href: '#contact',
  },
  {
    tag: 'Integrations',
    title: 'Connect Everything',
    description:
      'Works with the tools you already love. Set up in minutes, not months.',
    cta: 'View integrations',
    href: '#contact',
  },
];
---

<section id="solutions" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-ink">Our solutions</h2>
      <p class="mt-4 text-lg text-ink/70 max-w-xl mx-auto">
        Purpose-built to remove friction at every level.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {solutions.map(({ tag, title, description, cta, href }) => (
        <div class="flex flex-col rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="bg-brand-50 px-6 py-4">
            <span class="inline-block text-xs font-semibold uppercase tracking-wider text-ink bg-brand-100 px-3 py-1 rounded-full">
              {tag}
            </span>
          </div>
          <div class="flex flex-col flex-1 p-6">
            <h3 class="text-xl font-bold text-ink mb-3">{title}</h3>
            <p class="text-ink/70 text-sm leading-relaxed flex-1">{description}</p>
            <a
              href={href}
              class="mt-6 text-sm font-semibold text-ink hover:text-ink/70 transition-colors inline-flex items-center gap-1"
            >
              {cta} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
