---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pauči | Jednoduchá regulácia mobilov v školách',
  description = 'Pauči je uzamykateľné puzdro na mobil určené na jednoduchú reguláciu používania telefónov počas vyučovania.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="antialiased text-ink bg-cream overflow-x-clip">
    <slot />
  </body>
</html>
