---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pauci – Smart Solutions',
  description = 'Pauci helps you achieve more with less.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="antialiased text-ink bg-cream">
    <slot />
  </body>
</html>
